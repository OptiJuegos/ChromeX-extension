{
  "manifest_version": 3,
  "name": "ChromeX Lite — LITE / PRO / EXTREME",
  "version": "1.4.0",
  "minimum_chrome_version": "120",
  "description": "Optimización por eventos con CSS Performance Engine, Site Optimizer, Mobile Site Mode y carga reducida para hardware modesto.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChromeX Lite"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "telemetry",
        "enabled": true,
        "path": "rules/telemetry.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
